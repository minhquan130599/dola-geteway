# ==============================================================
# Dola Render Gateway Configuration (Example)
# ==============================================================

# Public URL used for video links returned by API and Dashboard
# Cập nhật địa chỉ này mỗi khi URL Cloudflare Tunnel / Domain thay đổi:
PUBLIC_BASE_URL=https://coastal-governmental-halo-suggesting.trycloudflare.com
DOLA_PUBLIC_BASE=https://coastal-governmental-halo-suggesting.trycloudflare.com

# Server Bind
DOLA_HOST=0.0.0.0
DOLA_PORT=8000

# Concurrency & Queue
DOLA_MAX_CONCURRENCY=3
DOLA_MAX_PENDING_TASKS=100
DOLA_VIDEO_TIMEOUT=300

# Admin Credentials & Security
DOLA_ADMIN_USERNAME=admin
DOLA_ADMIN_PASSWORD=Minhquan@130599
DOLA_JWT_SECRET=dola_pool_jwt_secret_Minhquan@130599_2026
